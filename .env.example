# Copia questo file in `.env` e compila i valori.
# `.env` è escluso da git: non committare mai credenziali reali.

# true solo in sviluppo: mostra i dettagli degli errori a schermo
APP_DEBUG=false

DB_HOST=127.0.0.1
DB_USER=lms_user
DB_PASS=change-me
DB_NAME=lms

# URL pubblico, senza slash finale
BASE_URL=http://localhost:8000

# Opzionale: publisher ID Google AdSense (es. ca-pub-0000000000000000)
ADSENSE_CLIENT=
